{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "core:window:allow-destroy",
    "opener:default",
    "updater:default",
    "process:allow-restart",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "allow-write-diagram-file",
    "allow-hold-api-key",
    "allow-save-api-key",
    "allow-discard-api-key",
    "allow-delete-api-key",
    "allow-stored-api-keys",
    "allow-provider-request",
    "allow-cancel-provider-request"
  ]
}
